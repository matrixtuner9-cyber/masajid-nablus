{
 "cleanUrls": false,
 "trailingSlash": true,
 "rewrites": [
  {
   "source": "/imam",
   "destination": "/index.html"
  },
  {
   "source": "/imam/(.*)",
   "destination": "/index.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  },
  {
   "source": "/(index.html|admin.js|shim.js)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/app/(.*)",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/vnd.android.package-archive"
    },
    {
     "key": "Content-Disposition",
     "value": "attachment; filename=masajid-nablus.apk"
    },
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ]
}